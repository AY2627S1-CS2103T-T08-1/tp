@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
participant ":FindCommandParser" as FindCommandParser LOGIC_COLOR
participant "f:FindCommand" as FindCommand LOGIC_COLOR
participant "r:CommandResult" as CommandResult LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "p:PersonContainsKeywordsPredicate" as Predicate MODEL_COLOR
participant "m:Model" as Model MODEL_COLOR
end box

[-> LogicManager : execute("find /name D       Est")
activate LogicManager

LogicManager -> AddressBookParser : parseCommand(commandText)
activate AddressBookParser

create FindCommandParser
AddressBookParser -> FindCommandParser
activate FindCommandParser

FindCommandParser --> AddressBookParser
deactivate FindCommandParser

AddressBookParser -> FindCommandParser : parse(" /name D       Est")
activate FindCommandParser

note right of FindCommandParser
  Trim surrounding whitespace.
  Collapse repeated whitespace.
  Validate exactly one syntax and criterion.
  Mixed syntax or missing input throws
  the same invalid-format error.
end note

create Predicate
FindCommandParser -> Predicate : NAME, ["D Est"]
activate Predicate

Predicate --> FindCommandParser
deactivate Predicate

create FindCommand
FindCommandParser -> FindCommand : p
activate FindCommand

FindCommand --> FindCommandParser
deactivate FindCommand

FindCommandParser --> AddressBookParser : f
deactivate FindCommandParser
'Hidden arrow to position the destroy marker below the end of the activation bar.
FindCommandParser -[hidden]-> AddressBookParser
destroy FindCommandParser

AddressBookParser --> LogicManager : f
deactivate AddressBookParser

LogicManager -> FindCommand : execute(m)
activate FindCommand

FindCommand -> Model : isShowingArchiveList()
activate Model
Model --> FindCommand : archiveScope
deactivate Model

alt archiveScope
    FindCommand -> Model : updateFilteredPersonList(PREDICATE_SHOW_ARCHIVED_PERSONS)
else active scope
    FindCommand -> Model : updateFilteredPersonList(PREDICATE_SHOW_ALL_PERSONS)
end

FindCommand -> Model : filterPersonsInCurrentList(p)
activate Model
note right of Model
  Combine scope AND search predicate.
  Match "D Est" as one substring,
  ignoring case.
  Replace prior search criteria;
  preserve sort order and list scope,
  even when there are zero matches.
end note
Model --> FindCommand
deactivate Model

FindCommand -> Model : getFilteredPersonList()
activate Model

Model --> FindCommand : filteredPersonsList
deactivate Model

create CommandResult
FindCommand -> CommandResult : match count
activate CommandResult

CommandResult --> FindCommand
deactivate CommandResult

FindCommand --> LogicManager : r
deactivate FindCommand

LogicManager -> FindCommand : modifiesData()
activate FindCommand

FindCommand --> LogicManager : false
deactivate FindCommand

[<-- LogicManager : r
deactivate LogicManager
@enduml
