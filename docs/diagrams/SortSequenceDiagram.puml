@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
participant ":SortCommandParser" as SortCommandParser LOGIC_COLOR
participant "s:SortCommand" as SortCommand LOGIC_COLOR
participant "r:CommandResult" as CommandResult LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
end box

[-> LogicManager : execute("sort priority desc")
activate LogicManager

LogicManager -> AddressBookParser : parseCommand("sort priority desc")
activate AddressBookParser

create SortCommandParser
AddressBookParser -> SortCommandParser
activate SortCommandParser

SortCommandParser --> AddressBookParser
deactivate SortCommandParser

AddressBookParser -> SortCommandParser : parse(" priority desc")
activate SortCommandParser

note right of SortCommandParser
  Throws ParseException if the criterion or direction
  is missing or unknown, recent is given a direction,
  or there are extra arguments.
end note

create SortCommand
SortCommandParser -> SortCommand : SortCommand(PRIORITY, false)
activate SortCommand

SortCommand --> SortCommandParser
deactivate SortCommand

SortCommandParser --> AddressBookParser : s
deactivate SortCommandParser
'Hidden arrow to position the destroy marker below the end of the activation bar.
SortCommandParser -[hidden]-> AddressBookParser
destroy SortCommandParser

AddressBookParser --> LogicManager : s
deactivate AddressBookParser

LogicManager -> SortCommand : execute(m)
activate SortCommand

SortCommand -> Model : updateSortedPersonList(comparator)
activate Model

Model --> SortCommand
deactivate Model

create CommandResult
SortCommand -> CommandResult : CommandResult(sortedMessage)
activate CommandResult

CommandResult --> SortCommand
deactivate CommandResult

SortCommand --> LogicManager : r
deactivate SortCommand

LogicManager -> SortCommand : modifiesData()
activate SortCommand

SortCommand --> LogicManager : false
deactivate SortCommand

[<-- LogicManager : r
deactivate LogicManager
@enduml
