@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
participant "c:Command" as Command LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
end box

box Storage STORAGE_COLOR_T1
participant "s:Storage" as Storage STORAGE_COLOR
end box

[-> LogicManager : execute(commandText)
activate LogicManager

LogicManager -> AddressBookParser : parseCommand(commandText)
activate AddressBookParser

AddressBookParser --> LogicManager : c
deactivate AddressBookParser

LogicManager -> Model : getAddressBook()
activate Model

Model --> LogicManager : addressBook
deactivate Model

LogicManager -> LogicManager : keep a copy of addressBook

LogicManager -> Command : execute(m)
activate Command

Command --> LogicManager : r
deactivate Command

LogicManager -> Command : modifiesData()
activate Command

Command --> LogicManager : isModifying
deactivate Command

alt isModifying
    LogicManager -> Model : getAddressBook()
    activate Model

    Model --> LogicManager : addressBook
    deactivate Model

    LogicManager -> Storage : saveAddressBook(addressBook)
    activate Storage

    Storage --> LogicManager
    deactivate Storage

    opt the save failed
        LogicManager -> Model : setAddressBook(copy)
        activate Model

        Model --> LogicManager
        deactivate Model

        [<-- LogicManager : CommandException
    end
else else
    LogicManager -> LogicManager : log that the save is skipped
end

[<--LogicManager : r
deactivate LogicManager
@enduml
