<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Scene?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.stage.Stage?>

<fx:root minHeight="400.0" minWidth="600.0" title="Help" type="javafx.stage.Stage" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <icons>
    <Image url="@/images/help_icon.png" />
  </icons>
  <scene>
    <Scene>
      <stylesheets>
        <URL value="@HelpWindow.css" />
      </stylesheets>

      <VBox fx:id="helpMessageContainer" prefWidth="800.0" prefHeight="600.0" spacing="12.0">
        <padding>
          <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
        </padding>
        <Label styleClass="help-heading" text="Available commands" />
        <Label styleClass="help-hint" wrapText="true"
               text="Type a command in the command box. INDEX refers to a number in the displayed list. Square brackets indicate optional fields." />
        <TextArea fx:id="commandList" editable="false" wrapText="true" VBox.vgrow="ALWAYS" />
        <HBox alignment="CENTER_LEFT" spacing="10.0">
          <Label fx:id="helpMessage" wrapText="true" HBox.hgrow="ALWAYS" />
          <Button fx:id="copyButton" mnemonicParsing="false" onAction="#copyUrl" text="Copy URL" minWidth="80.0" />
        </HBox>
      </VBox>
    </Scene>
  </scene>
</fx:root>
